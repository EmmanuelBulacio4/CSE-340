<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= categoryDetails.name %>
        </h2>

        <h3>Service Projects</h3>
        <ul>
            <% projects.forEach(project=> { %>
                <li><a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a></li>
                <% }) %>
        </ul>

        <p><a href="">Edit Category</a></p>
    </main>
    <%- include('partials/footer') %>