<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-category/<%= categoryDetails.category_id %>" method="post">
            <div class="form-group">
                <label for="name">Category Name</label>
                <input type="text" id="name" name="name" maxlength="100" required value="<%= categoryDetails.name %>">
            </div>

            <button type="submit">Edit Category</button>
        </form>

    </main>
    <%- include('partials/footer') %>